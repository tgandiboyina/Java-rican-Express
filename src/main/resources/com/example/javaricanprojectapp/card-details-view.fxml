<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<AnchorPane xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.javaricanprojectapp.CardDetailsController">
    <children>
        <VBox alignment="CENTER" layoutX="0" layoutY="0" prefHeight="400" prefWidth="600" spacing="20" style="-fx-background-color: #E8DAD0;" AnchorPane.bottomAnchor="0" AnchorPane.leftAnchor="0" AnchorPane.rightAnchor="0" AnchorPane.topAnchor="0">
            <Label fx:id="cardDetailsLabel" style="-fx-font-size: 24px; -fx-font-weight: bold;" text="Card Details" />
            <TextField fx:id="chargeAmountField" maxWidth="300" promptText="Enter charge amount" style="-fx-font-size: 16px;" />
            <HBox alignment="CENTER" spacing="20">
                <Button onAction="#onAddChargeButtonClick" style="-fx-font-size: 16px;" text="Add Charge" />
                <Button fx:id="paymentButton" onAction="#onPaymentButtonClick" style="-fx-font-size: 16px;" text="Action" />
            </HBox>
            <Label fx:id="statusLabel" style="-fx-font-size: 16px;" />
            <Button onAction="#onBackButtonClick" style="-fx-font-size: 16px;" text="Back" />
        </VBox>
    </children>
</AnchorPane>
