<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<AnchorPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.example.javaricanprojectapp.CardDetailsController">
    <children>
        <VBox alignment="CENTER" spacing="20" layoutX="0" layoutY="0" prefWidth="600" prefHeight="400" AnchorPane.topAnchor="0" AnchorPane.bottomAnchor="0" AnchorPane.leftAnchor="0" AnchorPane.rightAnchor="0">
            <Label fx:id="cardDetailsLabel" text="Card Details" style="-fx-font-size: 24px; -fx-font-weight: bold;"/>
            <TextField fx:id="chargeAmountField" promptText="Enter charge amount" style="-fx-font-size: 16px;" maxWidth="300"/>
            <HBox alignment="CENTER" spacing="20">
                <Button text="Add Charge" onAction="#onAddChargeButtonClick" style="-fx-font-size: 16px;"/>
                <Button fx:id="paymentButton" text="Action" onAction="#onPaymentButtonClick" style="-fx-font-size: 16px;"/>
            </HBox>
            <Label fx:id="statusLabel" style="-fx-font-size: 16px;"/>
            <Button text="Back" onAction="#onBackButtonClick" style="-fx-font-size: 16px;"/>
        </VBox>
    </children>
</AnchorPane>



