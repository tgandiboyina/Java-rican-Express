<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox alignment="CENTER" prefHeight="600.0" prefWidth="800.0" spacing="15.0" style="-fx-background-color: #FFFFFF;" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1">
    <padding>
        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
    </padding>

    <Label text="User Dashboard" alignment="CENTER" textAlignment="CENTER" style="-fx-font-size: 24; -fx-font-weight: bold;" />

    <!-- Placeholder for displaying user's cards and other information -->
    <Label text="Your Cards" style="-fx-font-size: 18; -fx-font-weight: bold;" />
    <VBox fx:id="cardsContainer" spacing="10.0">
        <!-- Cards will be dynamically added here -->
    </VBox>
</VBox>
