<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox alignment="CENTER" prefHeight="735.0" prefWidth="1145.0" spacing="20.0" style="-fx-background-color: #E8DAD0;" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.javaricanprojectapp.HomeController">
    <padding>
        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
    </padding>
    <Label alignment="CENTER" contentDisplay="CENTER" prefHeight="139.0" prefWidth="844.0" text="Java-rican Express" textAlignment="CENTER">
        <font>
            <Font name="Verdana Bold" size="68.0" />
        </font>
    </Label>

    <Label fx:id="welcomeText" />
    <Button onAction="#onLoginButtonClick" prefHeight="55.0" prefWidth="250.0" style="-fx-background-color: #BEB2AB;" text="Login">
        <font>
            <Font name="Verdana Bold" size="32.0" />
        </font></Button>
    <Button layoutX="381.0" layoutY="381.0" onAction="#onHelloButtonClick" prefHeight="55.0" prefWidth="250.0" style="-fx-background-color: #BEB2AB;" text="Register">
        <font>
            <Font name="Verdana Bold" size="32.0" />
        </font>
    </Button>
</VBox>
